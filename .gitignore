# ============================================
# App ingestion staging (cloned Emergent repos)
# ============================================
# Match .ingestion/ at any depth (root or backend/.ingestion/).
**/.ingestion/
# Re-ingestion contracts at the repo root MUST be tracked — they're the
# source of truth for `/reingest-app` to diff against new source state.
# Un-ignore the root .ingestion/ and its mappings/ subtree, then re-ignore
# the staging clones and reverse-adapt notes that should stay local.
!/.ingestion/
!/.ingestion/mappings/
!/.ingestion/mappings/**
/.ingestion/staging/
/.ingestion/reverse-adapt/

# Environment files
*.env
*.env.*
!*.env.example
.claude/settings.local.json

# Local-only Docker Compose override (renames containers, etc. for dev workstations)
docker-compose.override.yml

# PR review scratch files (e.g. pr108_review_test.txt). Keep these
# out of the repo so review-cycle artifacts don't accidentally land
# on a feature branch.
pr*_review_test.txt
.claude/agents/
