# ============================================================
# AegisAxiom - Frontend Environment Variables
# Copy this file to .env:  cp .env.example .env
# ============================================================

# Backend API URL (must match backend port in docker-compose.yml)
REACT_APP_BACKEND_URL=http://localhost:8001

# Google OAuth 2.0 (required for Google SSO login)
REACT_APP_GOOGLE_CLIENT_ID=

# Realtime SSE delivery (v1.3) — cross-user live push for the projects module.
# Default: DISABLED (fail-safe). Set to "true" to enable; must match backend
# ENABLE_REALTIME_SSE AND require Cloud Run `--timeout=3600` (or equivalent
# long-lived HTTP/2 streaming support on the deploy target). Presence avatars
# and conflict detection work regardless.
REACT_APP_ENABLE_REALTIME_SSE=false
