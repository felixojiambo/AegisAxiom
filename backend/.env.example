# ============================================================
# AegisAxiom - Backend Environment Variables
# Copy this file to .env:  cp .env.example .env
# ============================================================

# === Core (required) ===
MONGO_URL=mongodb://mongo:27017
DB_NAME=aegis_crm
CHROMADB_URL=http://aegisaxiom-chromadb:8000
# PostgreSQL re-platform (Phase 0). Async SQLAlchemy/asyncpg URL for the new
# datastore. During the phased parallel run, Postgres coexists with Mongo/Chroma;
# MONGO_URL/DB_NAME/CHROMADB_URL above are retired only in Phase 11.
DATABASE_URL=postgresql+asyncpg://aegis:aegis@postgres:5432/aegis

# === Security (required) ===
# IMPORTANT: Change this in production!
JWT_SECRET=REPLACE_ME_BEFORE_DEPLOY

# === Admin auto-init (creates admin user on first startup) ===
ADMIN_EMAIL=REPLACE_ME_BEFORE_DEPLOY
ADMIN_PASSWORD=REPLACE_ME_BEFORE_DEPLOY
ADMIN_NAME=REPLACE_ME_BEFORE_DEPLOY

# === CORS ===
ALLOWED_ORIGINS=http://localhost:3000

# === Mode ===
PRODUCTION_MODE=false

# === Frontend URL (used for generating public links) ===
FRONTEND_URL=http://localhost:3000

# === Email (Resend.io - optional, leave blank to disable) ===
RESEND_API_KEY=
SENDER_EMAIL=

# === AI / LLM Configuration ===
# Emergent platform: set EMERGENT_LLM_KEY (uses platform's LLM proxy)
# Local dev / GCP:   set GEMINI_API_KEY and switch MODEL_PROVIDER to "google"
EMERGENT_LLM_KEY=
GEMINI_API_KEY=
# LLM provider selection for the conductor path (gemini | emergent)
MODEL_PROVIDER=
MODEL_NAME=
# devs.ai SOW drafter bearer (falls back to ANTHROPIC_API_KEY if unset)
SOW_DRAFTER_API_KEY=
# MATCH dev seed N8N bearer (blank = seed skips credential)
MATCH_DEV_N8N_TOKEN=
#For Emergent, uncomment:
#MODEL_PROVIDER=anthropic
#MODEL_NAME=claude-sonnet-4-5-20250929
# For Gemini, uncomment:
#   MODEL_PROVIDER=google
#   MODEL_NAME=gemini-3-flash-preview
#
# PREVIEW MODEL FALLBACK
# ----------------------
# Nova defaults to a Gemini *preview* model for the cash-flow
# projection demo. Preview models can hit quota or availability
# issues without warning, and the SDK occasionally lags on the
# preview surface. If `gemini-3-flash-preview` starts failing
# repeatedly with quota / 503 / SDK errors, switch to the
# stable fallback below:
#
#   MODEL_NAME=gemini-2.5-flash
#
# No code change is required; the call path picks up MODEL_NAME
# at request time. There is NO automatic preview→stable fallback
# wired into the call path today; this is operator-triggered.

# === AI Budget Limits ===
# Per chat session token limit (default 1000000)
AI_SESSION_TOKEN_BUDGET=1000000
# Per user daily token limit (default 5000000)
AI_DAILY_TOKEN_BUDGET=5000000
# Per admin daily token limit (default 5000000)
AI_ADMIN_DAILY_TOKEN_BUDGET=5000000
# Global daily token limit across all users (default 50000000)
AI_GLOBAL_DAILY_BUDGET=50000000

# === Procurement Bot (optional, leave blank to keep manual-review mode) ===
# AEGISAXIOM submits BOM payloads to an external procurement bot service.
# The bot fetches vendor quotes (out of AEGISAXIOM scope) and posts results
# back via the signed webhook in routes/sales_ops_procurement.py.
#
# Operational gating:
#   - Leave PROCUREMENT_BOT_BASE_URL or PROCUREMENT_BOT_API_KEY blank
#     to run in Mode B (manual-review). The submit route still creates
#     a sourcing-request row with status=review_required and
#     status_reason="bot_not_configured"; no outbound call is made.
#   - Leave PROCUREMENT_BOT_WEBHOOK_SECRET blank to make the webhook
#     return 503 procurement_webhook_not_configured on every call.
#     Signature verification fails closed; an unconfigured deploy
#     cannot accidentally accept any payload.
#
# PROCUREMENT_BOT_API_KEY is the outbound bearer the client sends when
# AEGISAXIOM calls the bot. PROCUREMENT_BOT_WEBHOOK_SECRET is the HMAC-SHA256
# shared secret the bot uses to sign quote callbacks AEGISAXIOM receives.
# They are deliberately two distinct secrets so rotating one does not
# require rotating the other. Neither value is ever printed to logs,
# audit rows, response bodies, or exception text.
PROCUREMENT_BOT_BASE_URL=
PROCUREMENT_BOT_API_KEY=
PROCUREMENT_BOT_WEBHOOK_SECRET=
# Outbound HTTP timeout for the bot client (seconds, default 30).
PROCUREMENT_BOT_TIMEOUT_SECONDS=30

# === SOW AI Generation (required for Sales Ops SOW features) ===
# API key for the LLM proxy (devs.ai) used to generate SMART proposals,
# milestones, and billing extraction from meeting transcripts.
ANTHROPIC_API_KEY=
SOW_DRAFTER_MODEL=anthropic-claude-4-5-sonnet
SOW_DRAFTER_BASE_URL=https://devs.ai/api/v1

# === Fireflies.ai (required for SOW transcript-based generation) ===
# Single team-wide key. All users see the same Fireflies account's transcripts.
# Get your key at: https://app.fireflies.ai/integrations/custom/fireflies
FIREFLIES_API_KEY=

# === SOW Google Docs Template ===
SOW_TEMPLATE_ID=

# === Google Cloud (required for SOW document generation — Phase 2) ===
# Path to Google service account credentials JSON file.
# The service account needs Google Docs API + Google Drive API enabled.
GOOGLE_SERVICE_ACCOUNT_FILE=
# Drive folder that exported SOW Google Docs land in.
# SIMPLIMETA_SOW_FOLDER_ID is the canonical name resolved by
# backend/services/google_docs_service.resolve_sow_folder_id();
# GOOGLE_DRIVE_FOLDER_ID is the backward-compatible alias that the
# resolver reads when the canonical var is unset.
SIMPLIMETA_SOW_FOLDER_ID=
GOOGLE_DRIVE_FOLDER_ID=
# Domain-wide delegation email for the service account (optional)
GOOGLE_IMPERSONATE_EMAIL=

# === Google OAuth 2.0 (required for Google SSO login) ===
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback

# === Event Bus ===
# "local" for in-process, "pubsub" for Google Cloud Pub/Sub
EVENT_BUS_BACKEND=local
GCP_PROJECT_ID=
PUBSUB_TOPIC=aegis-events

# === Realtime SSE delivery (v1.3) ===
# Cross-user live push for the projects module. Requires Cloud Run
# `--timeout=3600` (or any infra that allows long-lived HTTP/2 streams).
# Default: DISABLED (fail-safe). Set to "true" only when the matching
# infra config is in place — otherwise SSE connections hold open and
# get force-dropped every 5 minutes by Cloud Run, causing reconnect storms.
# Every other v1.3 feature (presence avatars, conflict detection, inline
# edit, bulk ops, AI, templates, etc.) works regardless of this flag.
# See .waves/projects-v1.3-adr-realtime-feature-flag.md
ENABLE_REALTIME_SSE=false

# === Zoho CRM (optional, leave blank to disable) ===
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=
ZOHO_WEBHOOK_SECRET=

# === Nova / Gemini quick-win knobs (optional) ===
# All of these are opt-in; omit any of them to keep the default behavior.
#
# Prompt caching — provider-agnostic master switch. When false (default),
# Nova LLM requests are sent without any cache markers, matching the
# pre-cache code path byte-for-byte.
NOVA_PROMPT_CACHE_ENABLED=false
#
# Gemini explicit context caching — only consulted when the provider is
# Google. When enabled, the Nova system prompt + tool schemas are
# uploaded once and reused via cached_content. Cache failures fall back
# to a normal uncached request.
GEMINI_CONTEXT_CACHE_ENABLED=false
GEMINI_CONTEXT_CACHE_TTL_SECONDS=3600
#
# Gemini thinking-level enum: minimal | low | medium | high.
# Leave unset to use the provider's default. Invalid values are logged
# and ignored — the call proceeds without thinking_config.
#GEMINI_THINKING_LEVEL=low
#
# Nova-specific token budgets — fall back to AI_SESSION_TOKEN_BUDGET /
# AI_DAILY_TOKEN_BUDGET when unset. Apply only to the "nova" route;
# every other agent continues to use the global AI_* limits.
NOVA_SESSION_TOKEN_BUDGET=1000000
NOVA_DAILY_TOKEN_BUDGET=5000000
NOVA_MAX_OUTPUT_TOKENS=8192
# === Contracts — bi-weekly invoice batch scheduler ===
# Token that authenticates external schedulers (Cloud Scheduler,
# GitHub Actions cron, n8n cron workflows, etc.) when they call
# POST /api/invoice-batches/build-biweekly/scheduled. The scheduler
# must send the same value in the X-Scheduler-Token request header.
# Leave blank to disable scheduled builds — the route fails closed
# with 503 scheduler_not_configured when this is unset. The route
# does NOT replace the manual /build trigger from the Invoice
# Batches admin UI; both paths coexist and reuse the same builder.
# See docs/contracts-time-mgmt/scheduler.md.
INVOICE_BATCH_SCHEDULER_TOKEN=

# Stale threshold (hours) before the scheduler status endpoint
# starts reporting health=critical. Default 384 hours = 14-day
# bi-weekly cadence + 2-day grace. Set to a smaller number on
# deploys that expect a tighter cadence. The
# /api/invoice-batches/scheduler/health endpoint returns 503 when
# configured AND the last successful scheduled run is older than
# this value, so external uptime monitors can alert. See
# docs/contracts-time-mgmt/scheduler.md.
INVOICE_BATCH_SCHEDULER_STALE_AFTER_HOURS=384
