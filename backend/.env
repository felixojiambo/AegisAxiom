# ============================================================
# AegisAxiom - Backend Environment Variables
# Copy this file to .env:  cp .env.example .env
# ============================================================

# === Core (required) ===
MONGO_URL=mongodb+srv://afohns:afohns24@afohns.wcmnm4m.mongodb.net/?appName=Afohns
DB_NAME=aegisaxiom

# === Security (required) ===
# IMPORTANT: Change this in production!
JWT_SECRET=local-dev-jwt-secret-change-in-production-a1b2c3d4e5f6

# === Admin auto-init (creates admin user on first startup) ===
ADMIN_EMAIL=admin@aegis.local
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin

# === CORS ===
ALLOWED_ORIGINS=http://localhost:3000

# === Mode ===
PRODUCTION_MODE=false

# === Frontend URL (used for generating public links) ===
FRONTEND_URL=http://localhost:3000

# === Email (Resend.io - optional, leave blank to disable) ===
RESEND_API_KEY=
SENDER_EMAIL=

# === AI / LLM Configuration ===
# Emergent platform: set EMERGENT_LLM_KEY (uses platform's LLM proxy)
# Local dev / GCP:   set GEMINI_API_KEY and switch MODEL_PROVIDER to "google"
EMERGENT_LLM_KEY=
#GEMINI_API_KEY=AIzaSyCByVKC5RVgft4VHR5C7NYOXxfqQbO5tEA
GEMINI_API_KEY=
#For Emergent, uncomment:
#MODEL_PROVIDER=anthropic
#MODEL_NAME=claude-sonnet-4-5-20250929
# For Gemini, uncomment:
MODEL_PROVIDER=google
MODEL_NAME=gemini-3-flash-preview
ENABLE_GEMINI_CACHE=true

# === AI Budget Limits ===
# Per chat session token limit (default 100000)
AI_SESSION_TOKEN_BUDGET=100000
# Per user daily token limit (default 500000)
AI_DAILY_TOKEN_BUDGET=500000
# Global daily token limit across all users (default 50000)
AI_GLOBAL_DAILY_BUDGET=5000000

#N8N_QBO_SYNC_WEBHOOK_URL=https://n8n.simplimeta.io/webhook/qbo/sync/trigger
# === QuickBooks Online (optional, leave blank to disable) ===
#QBO_CLIENT_ID=ABVpiGUEU2M017VRqpqdndSAiGmOEkWXtGBMtfiqP0SunEdJXj
#QBO_CLIENT_SECRET=6ChC3HnLmPQWoeHmwVoUfZoMe7EO2Zy0PPD1isfV
#QBO_REDIRECT_URI=https://n8n.simplimeta.io/rest/oauth2-credential/callback
#QBO_USE_SANDBOX=true
#QBO_WEBHOOK_SECRET=

# === SOW AI Generation (required for Sales Ops SOW features) ===
# API key for the LLM proxy (devs.ai) used to generate SMART proposals,
# milestones, and billing extraction from meeting transcripts.
#ANTHROPIC_API_KEY=sk-a09576afd1943ccb0a33da107f4b3b1d61940fe59cc9fc37
ANTHROPIC_API_KEY=
SOW_DRAFTER_MODEL=anthropic-claude-4-5-sonnet
SOW_DRAFTER_BASE_URL=https://devs.ai/api/v1

# === Fireflies.ai (required for SOW transcript-based generation) ===
# Single team-wide key. All users see the same Fireflies account's transcripts.
# Get your key at: https://app.fireflies.ai/integrations/custom/fireflies
#FIREFLIES_API_KEY=348d2366-3528-4bdf-a2e4-c8ba76ef6314

FIREFLIES_API_KEY=

# === Google Cloud (required for SOW document generation — Phase 2) ===
# Path to Google service account credentials JSON file.
# The service account needs Google Docs API + Google Drive API enabled.
# GOOGLE_SERVICE_ACCOUNT_FILE=google-service-account.json
# GOOGLE_DRIVE_FOLDER_ID=

# === Zoho CRM (optional, leave blank to disable) ===
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=
ZOHO_WEBHOOK_SECRET=
SKIP_STARTUP_SEEDS=true
SKIP_STARTUP_INDEXES=true
DISABLE_BACKGROUND_JOBS=true
SEED_AI_EMPLOYEES=false

NOVA_SESSION_TOKEN_BUDGET=1000000
NOVA_DAILY_TOKEN_BUDGET=5000000
NOVA_MAX_OUTPUT_TOKENS=8192


# Gemini latency control
GEMINI_THINKING_LEVEL=low


# New Nova/Gemini cache flags used by the Phase 1 code
NOVA_PROMPT_CACHE_ENABLED=true
GEMINI_CONTEXT_CACHE_ENABLED=true
GEMINI_CONTEXT_CACHE_TTL_SECONDS=3600

# === SOW / Google Doc generation ===

GOOGLE_SERVICE_ACCOUNT_FILE=google-service-account.json

SIMPLIMETA_SOW_FOLDER_ID=1cX-tSGE1ya4T6mMDMa9oEUTZpcEF-TR-

# Optional, but recommended if we know the template
SOW_TEMPLATE_ID=<google_doc_template_id>